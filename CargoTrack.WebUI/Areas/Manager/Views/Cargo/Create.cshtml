@model CreateCargoDto
@{
    ViewData["Title"] = "Kargo Kabul";
    var context = (CargoCreateContextDto)ViewBag.Context;
    var services = new[]
    {
        (AdditionalService.Insurance, "bi-shield-check", "Sigorta", "+25 ₺"),
        (AdditionalService.CashOnDelivery, "bi-cash-coin", "Kapıda Ödeme", "+15 ₺"),
        (AdditionalService.SmsNotification, "bi-chat-dots", "SMS Bildirimi", "+5 ₺"),
        (AdditionalService.WeekendDelivery, "bi-calendar-week", "Hafta Sonu", "+30 ₺")
    };
    var deliveryTypes = new[]
    {
        (DeliveryType.Standard, "bi-box-seam", "Standart", "3 iş günü"),
        (DeliveryType.Express, "bi-lightning-charge", "Hızlı", "1 iş günü · ×1,5"),
        (DeliveryType.SameDay, "bi-clock-history", "Aynı Gün", "Şehir içi · ×2,0")
    };
}
<div class="page-head">
    <div>
        <div class="crumbs"><a href="/Manager/Cargo/Index">Kargolar</a> / Yeni Gönderi</div>
        <h1>Kargo Kabul</h1>
        <p class="page-sub">Gönderici ve alıcıyı seçin, paketi ölçün; ücret ve tahmini teslim tarihi anında hesaplanır.</p>
    </div>
    <div class="page-actions"><a class="btn btn-ghost" href="/Manager/Customer/Create" target="_blank"><i class="bi bi-person-plus"></i> Yeni Müşteri</a></div>
</div>
<form method="post" data-cargo-create data-search-url="/Manager/Cargo/SearchCustomers" data-address-url="/Manager/Cargo/CustomerAddresses" data-quote-url="/Manager/Cargo/Quote">
    <div class="row g-4">
        <div class="col-xl-8">
            <div asp-validation-summary="ModelOnly" class="alert-ct error mb-3"></div>
            <div class="card-ct mb-4">
                <div class="card-head"><h2><span class="badge-ct badge-plain tag-info me-2">1</span>Taraflar</h2></div>
                <div class="card-body-ct">
                    <div class="row g-3">
                        <div class="col-md-6" data-party="sender">
                            <label class="form-label">Gönderici</label>
                            <div class="position-relative">
                                <div class="input-icon"><i class="bi bi-search"></i><input class="form-control" data-party-search placeholder="Ad, soyad veya telefon ile ara" autocomplete="off" /></div>
                                <div class="search-results d-none"></div>
                            </div>
                            <input type="hidden" asp-for="SenderId" value="" />
                            <div class="selected-party mt-2 d-none" data-party-chosen>
                                <span class="party"><span class="av ico-blue" style="width:38px;height:38px;border-radius:12px"><i class="bi bi-person"></i></span></span>
                                <div class="flex-grow-1"><div class="fw-bold" data-name></div><div class="small text-2" data-phone></div></div>
                                <button type="button" class="btn btn-ghost btn-icon" data-clear title="Kaldır"><i class="bi bi-x-lg"></i></button>
                            </div>
                            <span asp-validation-for="SenderId" class="field-error"></span>
                        </div>
                        <div class="col-md-6" data-party="receiver">
                            <label class="form-label">Alıcı</label>
                            <div class="position-relative">
                                <div class="input-icon"><i class="bi bi-search"></i><input class="form-control" data-party-search placeholder="Ad, soyad veya telefon ile ara" autocomplete="off" /></div>
                                <div class="search-results d-none"></div>
                            </div>
                            <input type="hidden" asp-for="ReceiverId" value="" />
                            <div class="selected-party mt-2 d-none" data-party-chosen>
                                <span class="party"><span class="av ico-orange" style="width:38px;height:38px;border-radius:12px"><i class="bi bi-person-check"></i></span></span>
                                <div class="flex-grow-1"><div class="fw-bold" data-name></div><div class="small text-2" data-phone></div></div>
                                <button type="button" class="btn btn-ghost btn-icon" data-clear title="Kaldır"><i class="bi bi-x-lg"></i></button>
                            </div>
                            <span asp-validation-for="ReceiverId" class="field-error"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="DeliveryAddressId" class="form-label">Teslimat adresi</label>
                            <select asp-for="DeliveryAddressId" class="form-select"><option value="">Önce alıcı seçin</option></select>
                            <span asp-validation-for="DeliveryAddressId" class="field-error"></span>
                            <div class="form-hint">Alıcının kayıtlı adresleri listelenir. Adres yoksa müşteri sayfasından ekleyin.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-ct mb-4">
                <div class="card-head"><h2><span class="badge-ct badge-plain tag-info me-2">2</span>Güzergah</h2></div>
                <div class="card-body-ct row g-3">
                    <div class="col-md-6">
                        <label asp-for="OriginBranchId" class="form-label">Çıkış şubesi</label>
                        @if (context.FixedOriginBranchId is not null)
                        {
                            <input type="hidden" asp-for="OriginBranchId" value="@context.FixedOriginBranchId" data-quote-field />
                            <div class="form-control d-flex align-items-center gap-2" style="background:var(--ct-surface)"><i class="bi bi-shop text-accent"></i><b>@context.FixedOriginBranchName</b><span class="ms-auto small text-muted-ct">Sizin şubeniz</span></div>
                        }
                        else
                        {
                            <select asp-for="OriginBranchId" class="form-select" asp-items="ViewBag.Branches" data-quote-field><option value="">Şube seçin</option></select>
                        }
                        <span asp-validation-for="OriginBranchId" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DestinationBranchId" class="form-label">Varış şubesi</label>
                        <select asp-for="DestinationBranchId" class="form-select" asp-items="ViewBag.Branches" data-quote-field><option value="">Şube seçin</option></select>
                        <span asp-validation-for="DestinationBranchId" class="field-error"></span>
                    </div>
                </div>
            </div>
            <div class="card-ct mb-4">
                <div class="card-head"><h2><span class="badge-ct badge-plain tag-info me-2">3</span>Paket Bilgisi</h2><span class="sub">Desi = En × Boy × Yükseklik / 3000</span></div>
                <div class="card-body-ct row g-3">
                    <div class="col-6 col-md-3"><label asp-for="Weight" class="form-label">Ağırlık (kg)</label><input asp-for="Weight" type="number" step="0.01" min="0" class="form-control" data-quote-field /><span asp-validation-for="Weight" class="field-error"></span></div>
                    <div class="col-6 col-md-3"><label asp-for="Width" class="form-label">En (cm)</label><input asp-for="Width" type="number" step="0.01" min="0" class="form-control" data-quote-field /><span asp-validation-for="Width" class="field-error"></span></div>
                    <div class="col-6 col-md-3"><label asp-for="Length" class="form-label">Boy (cm)</label><input asp-for="Length" type="number" step="0.01" min="0" class="form-control" data-quote-field /><span asp-validation-for="Length" class="field-error"></span></div>
                    <div class="col-6 col-md-3"><label asp-for="Height" class="form-label">Yükseklik (cm)</label><input asp-for="Height" type="number" step="0.01" min="0" class="form-control" data-quote-field /><span asp-validation-for="Height" class="field-error"></span></div>
                    <div class="col-md-6"><label asp-for="CargoType" class="form-label">Kargo tipi</label><select asp-for="CargoType" class="form-select" asp-items="Html.GetEnumSelectList<CargoType>()"></select></div>
                    <div class="col-md-6"><label asp-for="Description" class="form-label">İçerik açıklaması</label><input asp-for="Description" class="form-control" placeholder="Opsiyonel" /></div>
                </div>
            </div>
            <div class="card-ct">
                <div class="card-head"><h2><span class="badge-ct badge-plain tag-info me-2">4</span>Teslimat ve Ek Hizmetler</h2></div>
                <div class="card-body-ct">
                    <div class="row g-3 mb-4">
                        @foreach (var item in deliveryTypes)
                        {
                            <div class="col-md-4">
                                <label class="option-tile h-100">
                                    <input type="radio" name="DeliveryType" value="@((int)item.Item1)" data-quote-field @(Model.DeliveryType == item.Item1 || (Model.DeliveryType == 0 && item.Item1 == DeliveryType.Standard) ? "checked" : "") />
                                    <span class="tile"><i class="bi @item.Item2"></i><span><span class="t d-block">@item.Item3</span><span class="d">@item.Item4</span></span></span>
                                </label>
                            </div>
                        }
                    </div>
                    <input type="hidden" asp-for="AdditionalServices" value="@((int)Model.AdditionalServices)" />
                    <div class="row g-3">
                        @foreach (var item in services)
                        {
                            <div class="col-6 col-md-3">
                                <label class="option-tile h-100">
                                    <input type="checkbox" value="@((int)item.Item1)" data-service @(Model.AdditionalServices.HasFlag(item.Item1) ? "checked" : "") />
                                    <span class="tile"><i class="bi @item.Item2"></i><span><span class="t d-block">@item.Item3</span><span class="d">@item.Item4</span></span></span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card-ct quote-card" data-quote>
                <div class="card-head"><h2><i class="bi bi-receipt me-2 text-accent"></i>Ücret Özeti</h2></div>
                <div class="card-body-ct">
                    <div class="small text-muted-ct fw-bold text-uppercase">Toplam ücret</div>
                    <div class="price tabular" data-quote-price>— ₺</div>
                    <div class="alert-ct error mt-3 d-none" data-quote-error></div>
                    <div class="info-grid mt-3" style="grid-template-columns:1fr 1fr">
                        <div class="info-item"><div class="k">Desi</div><div class="v tabular" data-quote-desi>—</div></div>
                        <div class="info-item"><div class="k">Tahmini teslim</div><div class="v small" data-quote-date>—</div></div>
                    </div>
                    <hr />
                    <ul class="small text-2 ps-3 mb-0">
                        <li>Ücretlendirmede desi ile ağırlıktan büyük olan esas alınır.</li>
                        <li>Aynı gün teslimat yalnızca şehir içi gönderilerde geçerlidir.</li>
                        <li>Takip numarası kayıt sırasında otomatik üretilir.</li>
                    </ul>
                </div>
                <div class="card-foot"><button class="btn btn-brand btn-lg w-100" type="submit"><i class="bi bi-check2-circle"></i> Gönderiyi Oluştur</button></div>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
