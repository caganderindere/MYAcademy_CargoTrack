@model PerformanceReportDto
@{
    ViewData["Title"] = "Performans Raporu";
    var sendingChart = new ChartViewModel
    {
        Id = "chart-sending",
        Type = "bar",
        Label = "Gönderi",
        Horizontal = true,
        Labels = Model.TopSendingBranches.Select(x => x.Name).ToList(),
        Values = Model.TopSendingBranches.Select(x => x.Count).ToList()
    };
}
<div class="page-head">
    <div>
        <div class="crumbs">Genel</div>
        <h1>Performans Raporu</h1>
        <p class="page-sub">@Model.DateFrom.ToString("dd MMMM yyyy") – @Model.DateTo.ToString("dd MMMM yyyy") · @Model.DayCount gün</p>
    </div>
    <div class="page-actions"></div>
</div>
<div class="card-ct mb-4">
    <form class="filter-bar rounded-4 border-0" method="get">
        <div class="filter-item"><label>Başlangıç</label><input type="date" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="filter-item"><label>Bitiş</label><input type="date" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <button class="btn btn-ink" type="submit"><i class="bi bi-arrow-repeat"></i> Raporu Güncelle</button>
        <div class="ms-auto d-flex gap-2">
            <a class="btn btn-ghost btn-sm" href="?dateFrom=@DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd")&dateTo=@DateTime.Today.ToString("yyyy-MM-dd")">Son 7 gün</a>
            <a class="btn btn-ghost btn-sm" href="?dateFrom=@DateTime.Today.AddDays(-29).ToString("yyyy-MM-dd")&dateTo=@DateTime.Today.ToString("yyyy-MM-dd")">Son 30 gün</a>
            <a class="btn btn-ghost btn-sm" href="?dateFrom=@DateTime.Today.AddDays(-89).ToString("yyyy-MM-dd")&dateTo=@DateTime.Today.ToString("yyyy-MM-dd")">Son 90 gün</a>
        </div>
    </form>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl"><div class="card-ct kpi kpi-dark"><div class="kpi-top"><span class="kpi-lbl">Toplam Gönderi</span></div><div class="kpi-val tabular">@Model.TotalCargos</div><div class="kpi-foot">@Model.DeliveredCargos teslim edildi</div></div></div>
    <div class="col-6 col-xl"><div class="card-ct kpi"><div class="kpi-top"><span class="kpi-lbl">Ort. Teslimat Süresi</span><span class="kpi-ico ico-blue"><i class="bi bi-stopwatch"></i></span></div><div class="kpi-val tabular">@(Model.AverageDeliveryHours is null ? "-" : Model.AverageDeliveryHours + " sa")</div><div class="kpi-foot">Kabulden teslime</div></div></div>
    <div class="col-6 col-xl"><div class="card-ct kpi"><div class="kpi-top"><span class="kpi-lbl">Zamanında Teslimat</span><span class="kpi-ico ico-green"><i class="bi bi-check2-circle"></i></span></div><div class="kpi-val tabular">%@Model.OnTimeRate</div><div class="progress-ct"><div style="width:@(Model.OnTimeRate.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div></div></div>
    <div class="col-6 col-xl"><div class="card-ct kpi"><div class="kpi-top"><span class="kpi-lbl">İade Oranı</span><span class="kpi-ico ico-red"><i class="bi bi-arrow-counterclockwise"></i></span></div><div class="kpi-val tabular">%@Model.ReturnRate</div><div class="kpi-foot">İade süreci + iade edilen</div></div></div>
</div>
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card-ct p-4 h-100">
            <span class="eyebrow"><i class="bi bi-trophy"></i> En çok gönderen</span>
            <div class="fs-4 fw-bold mt-2">@(Model.TopSendingBranch?.Name ?? "-")</div>
            <div class="text-2">@(Model.TopSendingBranch?.Count ?? 0) gönderi</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card-ct p-4 h-100">
            <span class="eyebrow" style="color:var(--ct-success)"><i class="bi bi-award"></i> En çok teslim eden</span>
            <div class="fs-4 fw-bold mt-2">@(Model.TopDeliveringBranch?.Name ?? "-")</div>
            <div class="text-2">@(Model.TopDeliveringBranch?.Count ?? 0) teslimat</div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card-ct h-100">
            <div class="card-head"><h2>En Fazla Geciken Kargoya Sahip Şubeler</h2><span class="sub">Varış şubesine göre</span></div>
            <div class="card-body-ct py-2">
                @if (!Model.DelayedBranches.Any())
                {
                    <div class="text-center text-muted-ct py-3"><i class="bi bi-emoji-smile me-1"></i>Geciken gönderi yok</div>
                }
                <ul class="rank-list">
                    @for (var i = 0; i < Model.DelayedBranches.Count; i++)
                    {
                        <li><span class="rk">@(i + 1)</span><span class="flex-grow-1 fw-bold">@Model.DelayedBranches[i].Name</span><span class="badge-ct badge-plain tag-delay">@Model.DelayedBranches[i].Count gecikme</span></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row g-4 mb-4">
    <div class="col-xl-5">
        <div class="card-ct h-100">
            <div class="card-head"><h2>En Çok Gönderi Çıkaran Şubeler</h2></div>
            <div class="card-body-ct"><partial name="_Chart" model="sendingChart" /></div>
        </div>
    </div>
    <div class="col-xl-7">
        <div class="card-ct h-100">
            <div class="card-head"><div><h2>Şube Performansı</h2><div class="sub">Günlük işlem hacmi ve teslimat başarı oranı</div></div></div>
            <div class="table-responsive" style="max-height:420px">
                <table class="table table-ct">
                    <thead><tr><th>Şube</th><th class="text-end">İşlem</th><th class="text-end">Günlük</th><th class="text-end">Teslim</th><th class="text-end">Başarısız</th><th class="text-end">Gecikme</th><th style="min-width:140px">Başarı</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.BranchPerformances)
                        {
                            <tr>
                                <td><div class="cell-title">@item.BranchName</div><div class="cell-sub">@item.CityName</div></td>
                                <td class="text-end tabular">@item.MovementCount</td>
                                <td class="text-end tabular">@item.DailyMovementAverage</td>
                                <td class="text-end tabular text-success fw-bold">@item.DeliveredCount</td>
                                <td class="text-end tabular text-danger">@item.FailedCount</td>
                                <td class="text-end tabular">@item.DelayedCount</td>
                                <td><div class="d-flex align-items-center gap-2"><div class="progress-ct flex-grow-1"><div style="width:@(item.SuccessRate.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div><span class="small fw-bold tabular">%@item.SuccessRate</span></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="card-ct">
    <div class="card-head"><div><h2>Personel Performansı</h2><div class="sub">Teslimat, başarısız teslimat ve günlük işlem sayısı</div></div></div>
    <div class="table-responsive">
        <table class="table table-ct">
            <thead><tr><th>Personel</th><th>Pozisyon</th><th>Birim</th><th class="text-end">Teslimat</th><th class="text-end">Başarısız</th><th class="text-end">İşlem</th><th class="text-end">Günlük İşlem</th><th class="text-end">Başarı</th></tr></thead>
            <tbody>
                @foreach (var item in Model.EmployeePerformances)
                {
                    <tr>
                        <td class="cell-title">@item.FullName</td>
                        <td><span class="badge-ct badge-plain tag-info">@item.Position.GetDisplayName()</span></td>
                        <td>@(item.UnitName ?? "-")</td>
                        <td class="text-end tabular fw-bold">@item.DeliveryCount</td>
                        <td class="text-end tabular text-danger">@item.FailedCount</td>
                        <td class="text-end tabular">@item.MovementCount</td>
                        <td class="text-end tabular">@item.DailyMovementAverage</td>
                        <td class="text-end tabular fw-bold">%@item.SuccessRate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
