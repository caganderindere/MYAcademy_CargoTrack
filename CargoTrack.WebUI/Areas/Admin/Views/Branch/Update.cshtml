@model UpdateBranchDto
@{
    ViewData["Title"] = "Şubeyi Düzenle";
}
<div class="page-head">
    <div>
        <div class="crumbs"><a href="/Admin/Branch">Şubeler</a> / Şubeyi Düzenle</div>
        <h1>Şubeyi Düzenle</h1>
        
    </div>
    <div class="page-actions"><a class="btn btn-ghost" href="/Admin/Branch"><i class="bi bi-arrow-left"></i> Listeye Dön</a></div>
</div>
<div class="row g-4">
    <div class="col-xl-9">
        <div class="card-ct">
            <div class="card-head"><h2><i class="bi bi-shop me-2 text-accent"></i>Şubeyi Düzenle</h2></div>
            <form method="post" class="card-body-ct row g-3">
                <div asp-validation-summary="ModelOnly" class="alert-ct error col-12"></div>
    <input type="hidden" asp-for="Id" />
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">Şube Adı</label>
        <input asp-for="Name" type="text" class="form-control" placeholder="Örn. Kadıköy Şubesi" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CityId" class="form-label">Şehir</label>
        <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities">
            <option value="">Şehir seçin</option>
        </select>
        <span asp-validation-for="CityId" class="field-error"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TransferCenterId" class="form-label">Bağlı Transfer Merkezi</label>
        <select asp-for="TransferCenterId" class="form-select" asp-items="ViewBag.TransferCenters">
            <option value="">Bağlı merkez yok</option>
        </select>
        <span asp-validation-for="TransferCenterId" class="field-error"></span>
        <div class="form-hint">Şubeden çıkan gönderilerin aktarıldığı bölge merkezi.</div>
    </div>
    <div class="col-md-6">
        <label asp-for="PhoneNumber" class="form-label">Telefon</label>
        <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="0216XXXXXXX" />
        <span asp-validation-for="PhoneNumber" class="field-error"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Address" class="form-label">Adres</label>
        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Address" class="field-error"></span>
    </div>
    <div class="col-md-12">
        <div class="form-check form-switch p-3 rounded-4 d-flex align-items-center gap-3" style="background:var(--ct-surface)">
            <input asp-for="IsActive" class="form-check-input ms-0 mt-0" type="checkbox" role="switch" style="width:2.6em;height:1.4em" />
            <label asp-for="IsActive" class="form-check-label fw-bold">Şube aktif ve gönderi kabul ediyor</label>
        </div>
    </div>
                <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top mt-4">
                    <a class="btn btn-ghost" href="/Admin/Branch">Vazgeç</a>
                    <button class="btn btn-brand" type="submit"><i class="bi bi-check2"></i> Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
