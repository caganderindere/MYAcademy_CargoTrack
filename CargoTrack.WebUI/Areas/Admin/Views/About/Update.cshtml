@model UpdateAboutDto
@{
    ViewData["Title"] = "İçeriği Düzenle";
}
<div class="page-head">
    <div>
        <div class="crumbs"><a href="/Admin/About">Kurumsal İçerik</a> / İçeriği Düzenle</div>
        <h1>İçeriği Düzenle</h1>
        
    </div>
    <div class="page-actions"><a class="btn btn-ghost" href="/Admin/About"><i class="bi bi-arrow-left"></i> Listeye Dön</a></div>
</div>
<div class="row g-4">
    <div class="col-xl-9">
        <div class="card-ct">
            <div class="card-head"><h2><i class="bi bi-file-richtext me-2 text-accent"></i>İçeriği Düzenle</h2></div>
            <form method="post" class="card-body-ct row g-3">
                <div asp-validation-summary="ModelOnly" class="alert-ct error col-12"></div>
    <input type="hidden" asp-for="Id" />
    <div class="col-md-12">
        <label asp-for="Title" class="form-label">Başlık</label>
        <input asp-for="Title" type="text" class="form-control" />
        <span asp-validation-for="Title" class="field-error"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="ImageUrl" class="form-label">Görsel URL</label>
        <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://..." />
        <span asp-validation-for="ImageUrl" class="field-error"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Description" class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>
    </div>
                <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top mt-4">
                    <a class="btn btn-ghost" href="/Admin/About">Vazgeç</a>
                    <button class="btn btn-brand" type="submit"><i class="bi bi-check2"></i> Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
