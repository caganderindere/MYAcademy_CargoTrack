@model LoginUserDto
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_AuthLayout";
}
<div class="mb-4">
    <a class="brand d-lg-none mb-4" href="/"><img src="~/img/logo-mark.svg" alt="CargoTrack" /><span>Cargo<b>Track</b></span></a>
    <h1>Tekrar hoş geldiniz</h1>
    <p class="text-2">Hesabınıza giriş yaparak gönderilerinizi ve operasyon panelinizi yönetin.</p>
</div>
<form method="post" class="d-grid gap-3">
    <div asp-validation-summary="ModelOnly" class="alert-ct error"></div>
    <div>
        <label asp-for="UserName" class="form-label">Kullanıcı Adı</label>
        <div class="input-icon"><i class="bi bi-person"></i><input asp-for="UserName" class="form-control" placeholder="kullanici.adi" autocomplete="username" /></div>
        <span asp-validation-for="UserName" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Password" class="form-label">Şifre</label>
        <div class="input-icon"><i class="bi bi-lock"></i><input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" /></div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <button class="btn btn-brand btn-lg w-100 mt-2" type="submit">Giriş Yap <i class="bi bi-arrow-right"></i></button>
</form>
<div class="text-center mt-4 text-2">Hesabınız yok mu? <a class="fw-bold" href="/Register/Signup">Hemen oluşturun</a></div>
<div class="text-center mt-2"><a class="small text-muted-ct" href="/Tracking"><i class="bi bi-search me-1"></i>Giriş yapmadan kargo takip et</a></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
