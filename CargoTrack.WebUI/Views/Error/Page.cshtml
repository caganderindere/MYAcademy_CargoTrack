@model ErrorPageViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="container">
    <div class="error-page">
        <div>
            <div class="code">@Model.StatusCode</div>
            <span class="kpi-ico ico-orange mx-auto my-3" style="width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.5rem"><i class="bi @Model.Icon"></i></span>
            <h1 class="mb-2">@Model.Title</h1>
            <p class="text-2 mx-auto" style="max-width:480px">@Model.Message</p>
            <div class="d-flex gap-2 justify-content-center mt-4">
                <a class="btn btn-ghost" href="javascript:history.back()"><i class="bi bi-arrow-left"></i> Geri Dön</a>
                <a class="btn btn-brand" href="/"><i class="bi bi-house"></i> Ana Sayfa</a>
            </div>
            @if (Model.RequestId is not null)
            {
                <p class="small text-muted-ct mt-4">Hata kodu: <span class="mono">@Model.RequestId</span></p>
            }
        </div>
    </div>
</div>
