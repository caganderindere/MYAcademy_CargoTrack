@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    string Active(string prefix) => (prefix == "/" ? path == "/" || path == "/home" || path == "/home/index" : path.StartsWith(prefix)) ? "active" : "";
    var hasAlert = TempData.Peek("Success") is not null || TempData.Peek("Error") is not null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B1B33" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/cargotrack.css" asp-append-version="true" />
    <title>@(ViewData["Title"] is string title ? title + " | CargoTrack" : "CargoTrack | Akıllı Kargo ve Lojistik")</title>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="topline d-none d-md-block">
        <div class="container d-flex justify-content-between">
            <span><i class="bi bi-headset me-1"></i> Müşteri Hizmetleri <a href="tel:4440000" class="fw-bold ms-1">444 0 000</a></span>
            <span><i class="bi bi-clock me-1"></i> Hafta içi 08:00 – 20:00 · Cumartesi 09:00 – 16:00</span>
        </div>
    </div>
    <header class="site-header">
        <nav class="navbar navbar-expand-xl">
            <div class="container">
                <a class="brand" href="/"><img src="~/img/logo-mark.svg" alt="CargoTrack" /><span>Cargo<b>Track</b></span></a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-label="Menü"><i class="bi bi-list fs-2"></i></button>
                <div class="collapse navbar-collapse" id="siteNav">
                    <ul class="navbar-nav mx-auto gap-xl-1 my-3 my-xl-0">
                        <li class="nav-item"><a class="nav-link @Active("/")" href="/">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/tracking")" href="/Tracking">Kargo Takip</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#hizmetler">Hizmetler</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/home/branches")" href="/Home/Branches">Şubelerimiz</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#kurumsal">Kurumsal</a></li>
                    </ul>
                    <div class="d-flex gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-ghost" href="/Login/Panel"><i class="bi bi-grid-1x2"></i> Panelim</a>
                            <a class="btn btn-ink" href="/Login/Logout"><i class="bi bi-box-arrow-right"></i> Çıkış</a>
                        }
                        else
                        {
                            <a class="btn btn-ghost" href="/Login">Giriş Yap</a>
                            <a class="btn btn-brand" href="/Register/Signup">Hesap Oluştur</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main>
        @if (hasAlert)
        {
            <div class="container pt-3"><partial name="_Alerts" /></div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="brand light mb-3" href="/"><img src="~/img/logo-mark.svg" alt="CargoTrack" /><span>Cargo<b>Track</b></span></a>
                    <p class="mt-3 mb-4" style="max-width:340px">Şubeden kapıya uçtan uca izlenebilir gönderi ağı. 81 ile uzanan operasyon, şeffaf fiyatlandırma ve doğrulanmış teslimat.</p>
                    <div class="d-flex gap-2">
                        <a class="btn btn-icon btn-ghost" href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a class="btn btn-icon btn-ghost" href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a class="btn btn-icon btn-ghost" href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Hizmetler</h5>
                    <ul>
                        <li><a href="/#hizmetler">Standart Teslimat</a></li>
                        <li><a href="/#hizmetler">Hızlı Kargo</a></li>
                        <li><a href="/#hizmetler">Aynı Gün Teslimat</a></li>
                        <li><a href="/#hizmetler">Kapıda Ödeme</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>Kurumsal</h5>
                    <ul>
                        <li><a href="/#kurumsal">Hakkımızda</a></li>
                        <li><a href="/Home/Branches">Şubelerimiz</a></li>
                        <li><a href="/Tracking">Kargo Takip</a></li>
                        <li><a href="/Login">Personel Girişi</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5>İletişim</h5>
                    <ul>
                        <li><i class="bi bi-geo-alt me-2"></i>Maslak Mah. Lojistik Cad. No:12 Sarıyer / İstanbul</li>
                        <li><i class="bi bi-telephone me-2"></i>444 0 000</li>
                        <li><i class="bi bi-envelope me-2"></i>destek@@cargotrack.com.tr</li>
                    </ul>
                </div>
            </div>
            <div class="bottom d-flex flex-column flex-md-row justify-content-between gap-2">
                <span>© @DateTime.Now.Year CargoTrack Lojistik A.Ş. Tüm hakları saklıdır.</span>
                <span><a href="#">KVKK Aydınlatma Metni</a> · <a href="#">Gizlilik</a> · <a href="#">Çerez Politikası</a></span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/cargotrack.js" asp-append-version="true"></script>
</body>
</html>
