@model RegisterUserDto
@{
    ViewData["Title"] = "Hesap Oluştur";
    Layout = "_AuthLayout";
}
<div class="mb-4">
    <a class="brand d-lg-none mb-4" href="/"><img src="~/img/logo-mark.svg" alt="CargoTrack" /><span>Cargo<b>Track</b></span></a>
    <h1>Hesap oluşturun</h1>
    <p class="text-2">Telefon numaranızla daha önce kargo gönderdiyseniz geçmiş gönderileriniz hesabınıza otomatik bağlanır.</p>
</div>
<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="alert-ct error col-12"></div>
    <div class="col-sm-6">
        <label asp-for="FirstName" class="form-label">Ad</label>
        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
        <span asp-validation-for="FirstName" class="field-error"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="LastName" class="form-label">Soyad</label>
        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
        <span asp-validation-for="LastName" class="field-error"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="Email" class="form-label">E-posta</label>
        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="PhoneNumber" class="form-label">Cep Telefonu</label>
        <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="05XXXXXXXXX" autocomplete="tel" />
        <span asp-validation-for="PhoneNumber" class="field-error"></span>
    </div>
    <div class="col-12">
        <label asp-for="UserName" class="form-label">Kullanıcı Adı</label>
        <input asp-for="UserName" class="form-control" autocomplete="username" />
        <span asp-validation-for="UserName" class="field-error"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="Password" class="form-label">Şifre</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrarı</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>
    <div class="col-12 form-hint">Şifre en az 6 karakter olmalı; büyük harf, küçük harf, rakam ve özel karakter içermelidir.</div>
    <div class="col-12"><button class="btn btn-brand btn-lg w-100" type="submit">Hesabımı Oluştur</button></div>
</form>
<div class="text-center mt-4 text-2">Zaten hesabınız var mı? <a class="fw-bold" href="/Login">Giriş yapın</a></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
